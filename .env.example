# Copia a .env.local (desarrollo) o define en Vercel (dev/preview/prod).
# Nunca commitees valores reales.

# Postgres de Neon (obligatoria). En Vercel, una por entorno.
DATABASE_URL=

# Seed de desarrollo: solo con flag explícito (protege producción).
ALLOW_SEED=false

# Auth.js (obligatorias en producción).
AUTH_SECRET=
AUTH_URL=

# Rate-limit en producción (Upstash Redis). Se conectó vía Vercel Storage y las
# KV_* se inyectaron solas; UPSTASH_* es alternativa manual (tiene prioridad).
# Sin ninguna, se usa memoria local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
